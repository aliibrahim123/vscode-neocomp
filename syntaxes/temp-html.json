{
	"scopeName": "inline.temp-html",
	"injectionSelector": "L:source.js -comment -string, L:source.js.jsx -comment -string, L:source.ts -comment -string, L:source.tsx -comment -string",
	"patterns": [{ "include": "#temp-tag" }],
	"repository": {
		"temp-tag": {
			"begin": "(html|\\$chunk)\\s*(`)",
			"beginCaptures": {
				"1": { "name": "entity.name.function.tagged-template.ts" },
				"2": { "name": "string.template.ts punctuation.definition.string.template.begin.ts" }
			},
			"end": "`",
			"endCaptures": {
				"0": { "name": "string.template.js punctuation.definition.string.template.end.ts" }
			},
			"contentName": "meta.embedded.block.html",
			"patterns": [
				{ "include": "#interpolation" },
				{ "include": "#html-tag" }
			]
		},
		"interpolation": {
			"name": "meta.template.expression.ts",
			"begin": "\\$\\{",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.template-expression.begin.ts" }
			},
			"end": "\\}",
			"endCaptures": {
				"0": { "name": "punctuation.definition.template-expression.end.ts" }
			},
			"contentName": "source.ts",
			"patterns": [{ "include": "source.ts" }]
		},
		"html-tag": {
			"comment": "tried with the standared html syntax but failed",
	  		"name": "meta.tag.html",
			"begin": "(</?)([-_a-zA-Z0-9:!.]*)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.html" },
				"2": { "name": "entity.name.tag.html" }
			},
			"end": "(/?>)|(\\s(?=`))",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.end.html" }
			},
			"patterns": [
				{ "include": "#interpolation" },
				{ "include": "#html-attribute" }
			]
		},

		"html-attribute": {
			"name": "meta.attribute.html",
			"begin": "\\b([^\\s=>`]+)",
			"beginCaptures": { 
				"0": { "name": "entity.other.attribute-name.html" } 
			},
			"end": "(?=\\s*+[^=`\\s])",
			"patterns": [{
				"begin": "=",
				"beginCaptures": { "name": "punctuation.separator.key-value.html" },
				"end": "(?<=[^\\s=])(?!\\s*=)|(?=/?>)",
				"patterns": [
					{ "include": "#interpolation" },
					{
						"match": "([^\\s\"'=<>`/]|/(?!>))+",
						"name": "string.unquoted.html"
					}, {
						"begin": "\"",
						"beginCaptures": {
							"0": { "name": "punctuation.definition.string.begin.html"}
						},
						"end": "\"",
						"endCaptures": {
							"0": { "name": "punctuation.definition.string.end.html"}
						},
						"name": "string.quoted.double.html"
					}, {
						"begin": "'",
						"beginCaptures": {
							"0": { "name": "punctuation.definition.string.begin.html"}
						},
						"end": "'",
						"endCaptures": {
							"0": { "name": "punctuation.definition.string.end.html"}
						},
						"name": "string.quoted.single.html"
					}
				]
			}]
		}
	}
}